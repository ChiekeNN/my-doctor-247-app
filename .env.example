# Copy this file to `.env` and fill in your own values.
# The `.env` file itself is git-ignored and must never be committed.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign login session cookies.
# Generate a strong one with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Fixed demo accounts are enabled automatically in development only.
# Set true only in a controlled demo environment; do not enable for public production.
ENABLE_DEMO_ACCOUNTS=false
