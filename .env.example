# Copy this file to `.env` and fill in your own values.
# The `.env` file itself is git-ignored and must never be committed.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign login session cookies.
# Generate a strong one with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Fixed demo accounts (admin/doctor/patient/institution) are enabled in every
# environment — development, preview and production — so the seeded logins work
# out of the box.
# Set this to true only to turn the shared demo logins off on a public deployment.
DISABLE_DEMO_ACCOUNTS=false
